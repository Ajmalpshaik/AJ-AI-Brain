node_modules/
*.log

# Generated knowledge graph (rebuild with `/graphify`). Derived from knowledge/,
# scripts/ and skills/ — it goes stale the moment any of those is edited, and a
# stale index in this repo is worse than no index.
graphify-out/

# Output of tools/verify-fragments-compile.ps1 — regenerated on every run, and the
# summary that matters is recorded in knowledge/brain-log.md instead.
fragment-compile-failures.txt

# Semantic (natural-language) retrieval layer — additive, sits alongside
# tools/fragment-index.mjs rather than replacing it. Contains a Python venv, the
# downloaded embedding model and a Chroma database: all derived, all rebuildable
# with `brain_index.py`, and all stale the moment knowledge/, scripts/ or skills/
# is edited — same reasoning as graphify-out/ above. The .py source is small and
# is un-ignored below so the code itself still travels with the Brain.
semantic-index/*
!semantic-index/*.py
!semantic-index/*.cmd
!semantic-index/*.md
!semantic-index/requirements.txt


# Python bytecode from tools/voice/drainer.py.
__pycache__/

# Voice runtime - the spoken-line queue, the generated-audio cache and the speaker's log.
# It sits INSIDE the repo rather than in %LOCALAPPDATA% for one hard reason: Claude Code writes any
# path outside the project folder into a throwaway overlay, so a queue kept outside received nothing
# the assistant ever queued and the assistant's voice never once played (proven 2026-08-11, see
# tools/voice/say.mjs). Ignored here so megabytes of generated MP3 still never travel with the Brain.
.voice-runtime/

# Job log DATA - machine-written, appended on every turn (tools/job-log-revit.mjs and
# brain_context.py --log). Committing it was tried on 2026-08-13 and reverted the same hour:
# a file that changes every turn leaves the working tree permanently dirty and blocks every
# checkout and merge. The data still travels with the Brain, because the Brain travels as a
# FOLDER - see job-log/README.md. Only the README is tracked.
job-log/*.jsonl

# SEPARATE Revit API index — the reflected API corpus and its own vector database.
# Both are large, version-specific and rebuildable (harvest-revit-api.cs -> index-api.cmd), and the
# corpus is Autodesk's API surface rather than this Brain's own work, so neither travels with the repo.
# Deliberately a different database from semantic-index/chroma-db: the Brain's search must never read it.
api-index/corpus/
api-index/chroma-db-api/
api-index/run-temp/
