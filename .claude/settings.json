{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"tools/auto-search-hook.mjs\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"tools/brain-status.mjs\""
          },
          {
            "type": "command",
            "command": "node \"tools/voice/narrate-hook.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"tools/voice/narrate-hook.mjs\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"tools/voice/narrate-hook.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"tools/voice/narrate-hook.mjs\""
          },
          {
            "type": "command",
            "command": "node \"tools/reindex-run.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"tools/reindex-mark.mjs\""
          },
          {
            "type": "command",
            "command": "node \"tools/verify-consistency-hook.mjs\""
          }
        ]
      }
    ]
  }
}
